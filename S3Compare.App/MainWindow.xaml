<Window x:Class="S3Compare.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:S3Compare.App.ViewModels"
        xmlns:conv="clr-namespace:S3Compare.App.Converters"
        mc:Ignorable="d"
        Title="S3 Bucket Comparison Tool (Wasabi &amp; S3 Compatible)" 
        Icon="icon.ico"
        Height="780" Width="1240"
        MinHeight="480" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        ShowInTaskbar="True"
        Topmost="True"
        Background="#0F172A"
        Foreground="#F8FAFC">

    <Window.DataContext>
        <vm:MainViewModel x:Name="ViewModel"/>
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <conv:InverseBooleanConverter x:Key="InverseBoolConverter"/>
        <conv:DifferenceTypeToBrushConverter x:Key="DiffTypeBrushConverter"/>

        <!-- Styles -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#475569"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#475569"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Override system brushes so ComboBox popup chrome never falls back to grey -->
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#1E293B"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#2563EB"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>

        <!-- ComboBox Toggle Button Template (Dark slate background with chevron arrow) -->
        <ControlTemplate x:Key="DarkComboBoxToggleButtonTemplate" TargetType="ToggleButton">
            <Border x:Name="TemplateRoot"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="28"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="1" Background="Transparent" SnapsToDevicePixels="True">
                        <Path x:Name="Arrow"
                              Width="9"
                              Height="5"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Data="M0,0 L4.5,4.5 L9,0 Z"
                              Fill="#94A3B8"
                              SnapsToDevicePixels="True"/>
                    </Border>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="TemplateRoot" Property="BorderBrush" Value="#38BDF8"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="#38BDF8"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="TemplateRoot" Property="BorderBrush" Value="#38BDF8"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="#38BDF8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="TemplateRoot" Property="Opacity" Value="0.5"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Editable TextBox Template inside ComboBox -->
        <ControlTemplate x:Key="DarkComboBoxTextBoxTemplate" TargetType="TextBox">
            <Border x:Name="Border"
                    Background="Transparent"
                    BorderThickness="0"
                    SnapsToDevicePixels="True">
                <ScrollViewer x:Name="PART_ContentHost"
                              Focusable="False"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Hidden"
                              VerticalAlignment="Center"/>
            </Border>
        </ControlTemplate>

        <!-- Dark ComboBoxItem Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D4ED8"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBox Style with Custom ControlTemplate -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#475569"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="MaxDropDownHeight" Value="320"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="MainGrid" SnapsToDevicePixels="True">
                            <ToggleButton x:Name="ToggleButton"
                                          Template="{StaticResource DarkComboBoxToggleButtonTemplate}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"/>

                            <!-- Non-Editable Content Display -->
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,4,30,4"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>

                            <!-- Editable TextBox -->
                            <TextBox x:Name="PART_EditableTextBox"
                                     Template="{StaticResource DarkComboBoxTextBoxTemplate}"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Center"
                                     Margin="10,2,30,2"
                                     Focusable="True"
                                     Background="Transparent"
                                     Foreground="{TemplateBinding Foreground}"
                                     CaretBrush="#38BDF8"
                                     FontSize="{TemplateBinding FontSize}"
                                     Visibility="Hidden"
                                     IsReadOnly="{TemplateBinding IsReadOnly}"/>

                            <!-- Dropdown Popup -->
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Slide"
                                   Focusable="False">
                                <Grid x:Name="DropDown"
                                      MinWidth="{Binding ActualWidth, ElementName=MainGrid}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="#1E293B"
                                            BorderBrush="#475569"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Margin="0,2,0,4">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="10" ShadowDepth="4" Opacity="0.6" Color="#000000"/>
                                        </Border.Effect>
                                        <ScrollViewer SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="40"/>
                            </Trigger>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter Property="IsTabStop" Value="False"/>
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleButton" Property="BorderBrush" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="ToggleButton" Property="BorderBrush" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="MainGrid" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#38BDF8"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10,6">
        <Grid.RowDefinitions>
            <!-- Top Controls Area (Scrollable & Collapsible) -->
            <RowDefinition Height="Auto" MaxHeight="430"/>
            <!-- Resizing Splitter -->
            <RowDefinition Height="6"/>
            <!-- Results & Discrepancies Panel -->
            <RowDefinition Height="*" MinHeight="140"/>
            <!-- Status Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP CONTROLS (SCROLLABLE & COLLAPSIBLE) -->
        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      Focusable="False"
                      Margin="0,0,0,2">
            <StackPanel MinWidth="820" Margin="0,0,4,0">
                <!-- HEADER (COMPACT) -->
                <Border Background="#1E293B" CornerRadius="6" Padding="10,6" Margin="0,0,0,6" BorderBrush="#334155" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⚡ S3 Bucket Compare" FontSize="16" FontWeight="Bold" Foreground="#38BDF8"/>
                                <Border Background="#0284C7" CornerRadius="4" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Wasabi &amp; S3 Optimized" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="High-capacity, paged dual-stream comparison engine with lexicographical streaming merge for TB/PB scale datasets." 
                                       FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Security Badges -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#14532D" CornerRadius="4" Padding="6,2" Margin="3,0" BorderBrush="#22C55E" BorderThickness="1">
                                <TextBlock Text="🛡️ 100% Read-Only Mode" FontSize="10" FontWeight="Bold" Foreground="#86EFAC"/>
                            </Border>
                            <Border Background="#312E81" CornerRadius="4" Padding="6,2" Margin="3,0" BorderBrush="#6366F1" BorderThickness="1">
                                <TextBlock Text="🔒 In-Memory Only (No Disk Stored Keys)" FontSize="10" FontWeight="Bold" Foreground="#C7D2FE"/>
                            </Border>
                            <Border Background="#701A75" CornerRadius="4" Padding="6,2" Margin="3,0" BorderBrush="#D946EF" BorderThickness="1">
                                <TextBlock Text="⚡ O(1) Memory Paging" FontSize="10" FontWeight="Bold" Foreground="#F5D0FE"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- CONFIGURATION HEADER & TOGGLE -->
                <DockPanel Margin="0,0,0,4">
                    <ToggleButton x:Name="ToggleConfig"
                                  IsChecked="True"
                                  DockPanel.Dock="Right"
                                  Background="#334155"
                                  Foreground="#38BDF8"
                                  FontSize="11"
                                  Padding="8,3"
                                  Cursor="Hand">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Content" Value="▲ Collapse Configuration"/>
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="False">
                                        <Setter Property="Content" Value="▼ Expand Configuration"/>
                                        <Setter Property="Background" Value="#1E293B"/>
                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <TextBlock Text="⚙ Bucket &amp; Connection Configuration" FontWeight="Bold" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/>
                </DockPanel>

                <!-- CONFIGURATION (TWO BUCKET CARDS - COLLAPSIBLE) -->
                <Grid Margin="0,0,0,6" Visibility="{Binding IsChecked, ElementName=ToggleConfig, Converter={StaticResource BoolToVisConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="380"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*" MinWidth="380"/>
                    </Grid.ColumnDefinitions>

                    <!-- BUCKET A (SOURCE) -->
                    <Border Grid.Column="0" Background="#1E293B" CornerRadius="6" Padding="10,8" BorderBrush="#334155" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                <TextBlock Text="📁 Bucket A (Source / Left)" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                <Button DockPanel.Dock="Right" Content="Test Connection" Command="{Binding TestConnectionACommand}"
                                        Background="#334155" Foreground="#E2E8F0" Padding="8,3" FontSize="11" HorizontalAlignment="Right"/>
                            </DockPanel>

                            <Grid Grid.Row="1" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Wasabi Region:" VerticalAlignment="Center" Foreground="#94A3B8"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Endpoints}" SelectedItem="{Binding SelectedPresetA, Mode=TwoWay}"
                                          DisplayMemberPath="Name"
                                          IsEnabled="{Binding CanEditConfig}"/>
                            </Grid>

                            <Grid Grid.Row="2" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Endpoint URL:" VerticalAlignment="Center" Foreground="#94A3B8"/>
                                <TextBox Grid.Column="1" Text="{Binding EndpointUrlA, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditConfig}"/>
                            </Grid>

                            <Grid Grid.Row="3" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="55"/>
                                    <ColumnDefinition Width="75"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Bucket Name:" VerticalAlignment="Center" Foreground="#94A3B8"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableBucketsA}" 
                                          Text="{Binding BucketNameA, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True"
                                          IsEnabled="{Binding CanEditConfig}"
                                          ToolTip="Type bucket name manually or select from discovered buckets"/>
                                <Button Grid.Column="2" Content="🔄 Discover" Command="{Binding FetchBucketsACommand}"
                                        Background="#334155" Foreground="#38BDF8" Padding="6,3" Margin="4,0,0,0" FontSize="11"
                                        ToolTip="Query endpoint to discover all accessible buckets for these credentials"
                                        IsEnabled="{Binding CanEditConfig}"/>
                                <TextBlock Grid.Column="3" Text="Region:" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0" Foreground="#94A3B8"/>
                                <TextBox Grid.Column="4" Text="{Binding RegionA, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditConfig}"/>
                            </Grid>

                            <Grid Grid.Row="4" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Access Key ID:" VerticalAlignment="Center" Foreground="#94A3B8"/>
                                <TextBox Grid.Column="1" Text="{Binding AccessKeyA, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditConfig}"/>
                            </Grid>

                            <Grid Grid.Row="5" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Secret Key:" VerticalAlignment="Center" Foreground="#94A3B8"/>
                                <PasswordBox x:Name="TxtSecretKeyA" Grid.Column="1" PasswordChanged="TxtSecretKeyA_PasswordChanged" IsEnabled="{Binding CanEditConfig}"/>
                                <TextBox x:Name="TxtSecretKeyAVisible" Grid.Column="1" Text="{Binding SecretKeyA, UpdateSourceTrigger=PropertyChanged}" 
                                         Visibility="Collapsed" IsEnabled="{Binding CanEditConfig}"/>
                                <Button x:Name="BtnToggleSecretA" Grid.Column="2" Content="👁" Margin="4,0,0,0" Padding="6,2" 
                                        Background="#334155" Foreground="White" Click="BtnToggleSecretA_Click" ToolTip="Show/Hide Secret Key"/>
                            </Grid>

                            <Grid Grid.Row="6" Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Prefix / Subpath:" VerticalAlignment="Center" Foreground="#94A3B8"/>
                                <DockPanel Grid.Column="1">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding TestResultA}" VerticalAlignment="Center" 
                                               FontSize="11" Foreground="#38BDF8" Margin="6,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                                    <TextBox Text="{Binding PrefixA, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditConfig}"
                                             ToolTip="Leave blank to compare entire bucket, or specify folder prefix like 'backup/2026/'"/>
                                </DockPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- BUCKET B (TARGET) -->
                    <Border Grid.Column="2" Background="#1E293B" CornerRadius="6" Padding="10,8" BorderBrush="#334155" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                <TextBlock Text="📁 Bucket B (Target / Right)" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                <Button DockPanel.Dock="Right" Content="Test Connection" Command="{Binding TestConnectionBCommand}"
                                        Background="#334155" Foreground="#E2E8F0" Padding="8,3" FontSize="11" HorizontalAlignment="Right"/>
                            </DockPanel>

                            <Grid Grid.Row="1" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Wasabi Region:" VerticalAlignment="Center" Foreground="#94A3B8"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Endpoints}" SelectedItem="{Binding SelectedPresetB, Mode=TwoWay}"
                                          DisplayMemberPath="Name"
                                          IsEnabled="{Binding CanEditConfig}"/>
                            </Grid>

                            <Grid Grid.Row="2" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Endpoint URL:" VerticalAlignment="Center" Foreground="#94A3B8"/>
                                <TextBox Grid.Column="1" Text="{Binding EndpointUrlB, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditConfig}"/>
                            </Grid>

                            <Grid Grid.Row="3" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="55"/>
                                    <ColumnDefinition Width="75"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Bucket Name:" VerticalAlignment="Center" Foreground="#94A3B8"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableBucketsB}" 
                                          Text="{Binding BucketNameB, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True"
                                          IsEnabled="{Binding CanEditConfig}"
                                          ToolTip="Type bucket name manually or select from discovered buckets"/>
                                <Button Grid.Column="2" Content="🔄 Discover" Command="{Binding FetchBucketsBCommand}"
                                        Background="#334155" Foreground="#38BDF8" Padding="6,3" Margin="4,0,0,0" FontSize="11"
                                        ToolTip="Query endpoint to discover all accessible buckets for these credentials"
                                        IsEnabled="{Binding CanEditConfig}"/>
                                <TextBlock Grid.Column="3" Text="Region:" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0" Foreground="#94A3B8"/>
                                <TextBox Grid.Column="4" Text="{Binding RegionB, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditConfig}"/>
                            </Grid>

                            <Grid Grid.Row="4" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Access Key ID:" VerticalAlignment="Center" Foreground="#94A3B8"/>
                                <TextBox Grid.Column="1" Text="{Binding AccessKeyB, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditConfig}"/>
                            </Grid>

                            <Grid Grid.Row="5" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Secret Key:" VerticalAlignment="Center" Foreground="#94A3B8"/>
                                <PasswordBox x:Name="TxtSecretKeyB" Grid.Column="1" PasswordChanged="TxtSecretKeyB_PasswordChanged" IsEnabled="{Binding CanEditConfig}"/>
                                <TextBox x:Name="TxtSecretKeyBVisible" Grid.Column="1" Text="{Binding SecretKeyB, UpdateSourceTrigger=PropertyChanged}" 
                                         Visibility="Collapsed" IsEnabled="{Binding CanEditConfig}"/>
                                <Button x:Name="BtnToggleSecretB" Grid.Column="2" Content="👁" Margin="4,0,0,0" Padding="6,2" 
                                        Background="#334155" Foreground="White" Click="BtnToggleSecretB_Click" ToolTip="Show/Hide Secret Key"/>
                            </Grid>

                            <Grid Grid.Row="6" Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Prefix / Subpath:" VerticalAlignment="Center" Foreground="#94A3B8"/>
                                <DockPanel Grid.Column="1">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding TestResultB}" VerticalAlignment="Center" 
                                               FontSize="11" Foreground="#38BDF8" Margin="6,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                                    <TextBox Text="{Binding PrefixB, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditConfig}"
                                             ToolTip="Leave blank to compare entire bucket, or specify folder prefix like 'backup/2026/'"/>
                                </DockPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- OPTIONS, CHECKPOINT & ACTION BAR -->
                <StackPanel Margin="0,0,0,6">
                    <!-- CHECKPOINT RESUME BANNER -->
                    <Border Background="#042F2E" CornerRadius="6" Padding="10,6" Margin="0,0,0,6" 
                            BorderBrush="#14B8A6" BorderThickness="1.5"
                            Visibility="{Binding HasResumableCheckpoint, Converter={StaticResource BoolToVisConverter}}">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                <Button Content="▶ Resume Scan from Checkpoint" Command="{Binding ResumeScanCommand}" 
                                        Background="#0D9488" Foreground="White" FontWeight="Bold" Padding="10,5" Margin="0,0,6,0"
                                        ToolTip="Continue scan starting immediately from the last evaluated key without rescanning from the beginning"/>
                                <Button Content="Discard Checkpoint" Command="{Binding DiscardCheckpointCommand}" 
                                        Background="#334155" Foreground="#CBD5E1" Padding="8,5"
                                        ToolTip="Delete checkpoint and start from the beginning"/>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚡ Resumable Scan Checkpoint Found" FontWeight="Bold" Foreground="#2DD4BF" FontSize="12"/>
                                    <TextBlock Text=" (Zero credentials saved to disk)" Foreground="#99F6E4" FontSize="11" Margin="6,1,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding CheckpointBannerText}" Foreground="#CCFBF1" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- OPTIONS & ACTION BAR -->
                    <Border Background="#1E293B" CornerRadius="6" Padding="8,5" BorderBrush="#334155" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Comparison Mode Selection -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Mode:" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12"/>
                                
                                <RadioButton IsChecked="{Binding IsListingOnlyMode, Mode=TwoWay}" GroupName="CompMode" VerticalAlignment="Center" Margin="0,0,10,0"
                                             IsEnabled="{Binding CanEditConfig}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📋 Listing Only " FontWeight="SemiBold" Foreground="#38BDF8" FontSize="12"/>
                                        <TextBlock Text="(Zero Egress)" FontSize="10" Foreground="#94A3B8"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton IsChecked="{Binding IsFullDataMode, Mode=TwoWay}" GroupName="CompMode" VerticalAlignment="Center" Margin="0,0,12,0"
                                             IsEnabled="{Binding CanEditConfig}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔍 Full Data " FontWeight="SemiBold" Foreground="#F59E0B" FontSize="12"/>
                                        <TextBlock Text="(Payload Check)" FontSize="10" Foreground="#94A3B8"/>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>

                            <!-- Advanced Detection & Live Stream Options -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- Synthetic Sequence Gap Checkbox -->
                                <CheckBox IsChecked="{Binding DetectSequenceGaps, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,4,0"
                                          IsEnabled="{Binding CanEditConfig}"/>
                                <TextBlock Text="Sequence Gaps:" VerticalAlignment="Center" Foreground="#F472B6" FontSize="11" Margin="0,0,4,0"
                                           ToolTip="Synthetically flags files missing on both sides when numeric sequences have gaps (e.g., 01, 03 -> missing 02)"/>
                                <TextBox Text="{Binding MaxSequenceGapThreshold, UpdateSourceTrigger=PropertyChanged}" Width="32" FontSize="11" Padding="3,1"
                                         IsEnabled="{Binding CanEditConfig}" ToolTip="Max gap size to report (default: 25)"/>

                                <Border Width="1" Background="#334155" Margin="8,2" Height="14"/>

                                <!-- Auto-Save CSV Streaming -->
                                <CheckBox IsChecked="{Binding AutoSaveLiveReport, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,4,0"
                                          IsEnabled="{Binding CanEditConfig}"/>
                                <TextBlock Text="Live CSV:" VerticalAlignment="Center" Foreground="#94A3B8" FontSize="11" Margin="0,0,4,0"/>
                                <TextBox Text="{Binding LiveReportPath, UpdateSourceTrigger=PropertyChanged}" Width="110" FontSize="11" Padding="3,1"
                                         IsEnabled="{Binding CanEditConfig}" ToolTip="Path to append CSV differences in real time"/>
                                <Button Content="..." Command="{Binding BrowseLiveReportPathCommand}" Background="#334155" Padding="5,1" Margin="3,0,0,0"
                                        IsEnabled="{Binding CanEditConfig}"/>
                            </StackPanel>

                            <!-- Action Buttons -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Content="▶ Start Comparison" Command="{Binding StartCommand}" Background="#059669" Margin="0,0,6,0"
                                        Padding="12,5" FontWeight="Bold" FontSize="12"/>
                                <Button Content="⏸ Pause / Resume" Command="{Binding PauseResumeCommand}" Background="#D97706" Margin="0,0,6,0"
                                        Padding="10,5" FontSize="11"/>
                                <Button Content="⏹ Stop" Command="{Binding StopCommand}" Background="#DC2626" Margin="0,0,6,0"
                                        Padding="10,5" FontSize="11"/>
                                <Button Content="💾 Export Report..." Command="{Binding ExportReportCommand}" Background="#4338CA" Margin="0,0,6,0"
                                        Padding="10,5" FontSize="11"/>
                                <Button Content="🔄 Clear" Command="{Binding ClearResultsCommand}" Background="#475569"
                                        Padding="8,5" FontSize="11"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- LIVE DUAL MONITORS HEADER & TOGGLE -->
                <DockPanel Margin="0,0,0,4">
                    <ToggleButton x:Name="TogglePanes"
                                  IsChecked="True"
                                  DockPanel.Dock="Right"
                                  Background="#334155"
                                  Foreground="#38BDF8"
                                  FontSize="11"
                                  Padding="8,3"
                                  Cursor="Hand">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Content" Value="▲ Collapse Live Monitors"/>
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="False">
                                        <Setter Property="Content" Value="▼ Expand Live Monitors"/>
                                        <Setter Property="Background" Value="#1E293B"/>
                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <TextBlock Text="⚡ Live Dual Stream Monitors" FontWeight="Bold" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/>
                </DockPanel>

                <!-- LIVE DUAL PROCESSING PANES (COLLAPSIBLE) -->
                <Grid Height="130" Margin="0,0,0,4" Visibility="{Binding IsChecked, ElementName=TogglePanes, Converter={StaticResource BoolToVisConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="380"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*" MinWidth="380"/>
                    </Grid.ColumnDefinitions>

                    <!-- PANE A -->
                    <Border Grid.Column="0" Background="#1E293B" CornerRadius="6" Padding="8,6" BorderBrush="#334155" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,4">
                                <TextBlock Text="Bucket A Paging Monitor" FontWeight="Bold" FontSize="12" Foreground="#38BDF8"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="Status: " Foreground="#94A3B8" FontSize="11"/>
                                    <TextBlock Text="{Binding StatusA}" FontWeight="SemiBold" Foreground="#F8FAFC" FontSize="11" Margin="0,0,8,0"/>
                                    <TextBlock Text="Objects: " Foreground="#94A3B8" FontSize="11"/>
                                    <TextBlock Text="{Binding ObjectsReadA, StringFormat={}{0:N0}}" FontWeight="Bold" Foreground="#38BDF8" FontSize="11" Margin="0,0,8,0"/>
                                    <TextBlock Text="Data: " Foreground="#94A3B8" FontSize="11"/>
                                    <TextBlock Text="{Binding BytesReadA}" FontWeight="Bold" Foreground="#38BDF8" FontSize="11"/>
                                </StackPanel>
                            </DockPanel>

                            <Border Grid.Row="1" Background="#0F172A" CornerRadius="4" Padding="6,2" Margin="0,0,0,4" BorderBrush="#334155" BorderThickness="1">
                                <DockPanel>
                                    <TextBlock Text="Key: " Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding CurrentKeyA}" Foreground="#E2E8F0" FontFamily="Consolas" FontSize="10" 
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentKeyA}"/>
                                </DockPanel>
                            </Border>

                            <!-- Paged Stream List A -->
                            <DataGrid Grid.Row="2" ItemsSource="{Binding RecentItemsA}" AutoGenerateColumns="False" IsReadOnly="True"
                                      Background="#0F172A" RowBackground="#0F172A" AlternatingRowBackground="#172033"
                                      Foreground="#F8FAFC" BorderBrush="#334155" GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#334155" HeadersVisibility="Column" SelectionMode="Single">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#1E293B"/>
                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Padding" Value="4,2"/>
                                        <Setter Property="FontSize" Value="10"/>
                                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                        <Setter Property="BorderBrush" Value="#334155"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="*" FontFamily="Consolas" FontSize="10"/>
                                    <DataGridTextColumn Header="Size" Binding="{Binding FormattedSize}" Width="75" FontSize="10"/>
                                    <DataGridTextColumn Header="ETag" Binding="{Binding ETag}" Width="95" FontFamily="Consolas" FontSize="10"/>
                                    <DataGridTextColumn Header="Last Modified" Binding="{Binding LastModified, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="110" FontSize="10"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#334155" ResizeBehavior="PreviousAndNext"/>

                    <!-- PANE B -->
                    <Border Grid.Column="2" Background="#1E293B" CornerRadius="6" Padding="8,6" BorderBrush="#334155" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,4">
                                <TextBlock Text="Bucket B Paging Monitor" FontWeight="Bold" FontSize="12" Foreground="#38BDF8"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="Status: " Foreground="#94A3B8" FontSize="11"/>
                                    <TextBlock Text="{Binding StatusB}" FontWeight="SemiBold" Foreground="#F8FAFC" FontSize="11" Margin="0,0,8,0"/>
                                    <TextBlock Text="Objects: " Foreground="#94A3B8" FontSize="11"/>
                                    <TextBlock Text="{Binding ObjectsReadB, StringFormat={}{0:N0}}" FontWeight="Bold" Foreground="#38BDF8" FontSize="11" Margin="0,0,8,0"/>
                                    <TextBlock Text="Data: " Foreground="#94A3B8" FontSize="11"/>
                                    <TextBlock Text="{Binding BytesReadB}" FontWeight="Bold" Foreground="#38BDF8" FontSize="11"/>
                                </StackPanel>
                            </DockPanel>

                            <Border Grid.Row="1" Background="#0F172A" CornerRadius="4" Padding="6,2" Margin="0,0,0,4" BorderBrush="#334155" BorderThickness="1">
                                <DockPanel>
                                    <TextBlock Text="Key: " Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding CurrentKeyB}" Foreground="#E2E8F0" FontFamily="Consolas" FontSize="10" 
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentKeyB}"/>
                                </DockPanel>
                            </Border>

                            <!-- Paged Stream List B -->
                            <DataGrid Grid.Row="2" ItemsSource="{Binding RecentItemsB}" AutoGenerateColumns="False" IsReadOnly="True"
                                      Background="#0F172A" RowBackground="#0F172A" AlternatingRowBackground="#172033"
                                      Foreground="#F8FAFC" BorderBrush="#334155" GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#334155" HeadersVisibility="Column" SelectionMode="Single">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#1E293B"/>
                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Padding" Value="4,2"/>
                                        <Setter Property="FontSize" Value="10"/>
                                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                        <Setter Property="BorderBrush" Value="#334155"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="*" FontFamily="Consolas" FontSize="10"/>
                                    <DataGridTextColumn Header="Size" Binding="{Binding FormattedSize}" Width="75" FontSize="10"/>
                                    <DataGridTextColumn Header="ETag" Binding="{Binding ETag}" Width="95" FontFamily="Consolas" FontSize="10"/>
                                    <DataGridTextColumn Header="Last Modified" Binding="{Binding LastModified, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="110" FontSize="10"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- SPLITTER BETWEEN CONTROLS AND RESULTS -->
        <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" Background="#334155" 
                      ResizeBehavior="PreviousAndNext" ToolTip="Drag to resize between controls and discrepancies log"/>

        <!-- RESULTS & DIFFERENCES TABLE -->
        <Border Grid.Row="2" Background="#1E293B" CornerRadius="6" Padding="10,8" Margin="0,2,0,4" BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Statistics Summary Cards -->
                    <RowDefinition Height="Auto"/>
                    <!-- Filter Toolbar -->
                    <RowDefinition Height="Auto"/>
                    <!-- Differences Grid -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- STATS CARDS -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#0F172A" CornerRadius="4" Padding="6,3" Margin="0,0,4,0" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Evaluated" FontSize="10" Foreground="#94A3B8"/>
                            <TextBlock Text="{Binding Statistics.ObjectsCompared, StringFormat={}{0:N0}}" FontSize="15" FontWeight="Bold" Foreground="#38BDF8"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="#0F172A" CornerRadius="4" Padding="6,3" Margin="0,0,4,0" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Matched" FontSize="10" Foreground="#94A3B8"/>
                            <TextBlock Text="{Binding Statistics.MatchedCount, StringFormat={}{0:N0}}" FontSize="15" FontWeight="Bold" Foreground="#4ADE80"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="#0F172A" CornerRadius="4" Padding="6,3" Margin="0,0,4,0" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Total Diffs" FontSize="10" Foreground="#94A3B8"/>
                            <TextBlock Text="{Binding Statistics.TotalDifferences, StringFormat={}{0:N0}}" FontSize="15" FontWeight="Bold" Foreground="#F87171"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Background="#0F172A" CornerRadius="4" Padding="6,3" Margin="0,0,4,0" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Missing in B" FontSize="10" Foreground="#94A3B8"/>
                            <TextBlock Text="{Binding Statistics.MissingInBucketBCount, StringFormat={}{0:N0}}" FontSize="15" FontWeight="Bold" Foreground="#FBBF24"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Background="#0F172A" CornerRadius="4" Padding="6,3" Margin="0,0,4,0" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Missing in A" FontSize="10" Foreground="#94A3B8"/>
                            <TextBlock Text="{Binding Statistics.MissingInBucketACount, StringFormat={}{0:N0}}" FontSize="15" FontWeight="Bold" Foreground="#60A5FA"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="5" Background="#0F172A" CornerRadius="4" Padding="6,3" Margin="0,0,4,0" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Size / Content" FontSize="10" Foreground="#94A3B8"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Statistics.SizeMismatchCount, StringFormat={}{0:N0}}" FontSize="15" FontWeight="Bold" Foreground="#EF4444"/>
                                <TextBlock Text="/" FontSize="13" Foreground="#64748B" Margin="3,0"/>
                                <TextBlock Text="{Binding Statistics.ContentMismatchCount, StringFormat={}{0:N0}}" FontSize="15" FontWeight="Bold" Foreground="#F43F5E"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="6" Background="#0F172A" CornerRadius="4" Padding="6,3" Margin="0,0,4,0" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Synthetic Gaps" FontSize="10" Foreground="#94A3B8"/>
                            <TextBlock Text="{Binding Statistics.SequenceGapCount, StringFormat={}{0:N0}}" FontSize="15" FontWeight="Bold" Foreground="#EC4899"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="7" Background="#0F172A" CornerRadius="4" Padding="6,3" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Rate / Time / RAM" FontSize="10" Foreground="#94A3B8"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Statistics.ItemsPerSecond, StringFormat={}{0:N0}/s}" FontSize="12" FontWeight="Bold" Foreground="#E2E8F0"/>
                                <TextBlock Text=" | " FontSize="12" Foreground="#64748B"/>
                                <TextBlock Text="{Binding Statistics.ElapsedTime, StringFormat={}{0:hh\\:mm\\:ss}}" FontSize="12" FontWeight="Bold" Foreground="#CBD5E1"/>
                                <TextBlock Text=" | " FontSize="12" Foreground="#64748B"/>
                                <TextBlock Text="{Binding Statistics.WorkingSetMB, StringFormat={}{0:N0}MB}" FontSize="12" FontWeight="Bold" Foreground="#A78BFA"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- FILTER TOOLBAR -->
                <DockPanel Grid.Row="1" Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Differences Log" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Text="Filter:" VerticalAlignment="Center" Foreground="#94A3B8" FontSize="11" Margin="0,0,6,0"/>
                        <ComboBox ItemsSource="{Binding FilterOptions}" SelectedItem="{Binding SelectedFilter, Mode=TwoWay}" Width="180"/>
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="#64748B"
                               Text="* Showing latest differences in memory; full report contains all differences."/>
                </DockPanel>

                <!-- DIFFERENCES DATAGRID -->
                <DataGrid Grid.Row="2" ItemsSource="{Binding FilteredDifferences}" AutoGenerateColumns="False" IsReadOnly="True"
                          Background="#0F172A" RowBackground="#0F172A" AlternatingRowBackground="#172033"
                          Foreground="#F8FAFC" BorderBrush="#334155" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#334155" HeadersVisibility="Column" SelectionMode="Single">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#1E293B"/>
                            <Setter Property="Foreground" Value="#94A3B8"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="6,4"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter Property="BorderBrush" Value="#334155"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="50" FontSize="11"/>
                        <DataGridTemplateColumn Header="Type" Width="145">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Type, Converter={StaticResource DiffTypeBrushConverter}}" 
                                            CornerRadius="4" Padding="5,1" HorizontalAlignment="Left" Margin="3,1">
                                        <TextBlock Text="{Binding TypeDisplay}" Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Object Key / Path" Binding="{Binding Key}" Width="2*" FontFamily="Consolas" FontSize="11"/>
                        <DataGridTextColumn Header="Bucket A Size" Binding="{Binding BucketASizeDisplay}" Width="90" FontSize="11"/>
                        <DataGridTextColumn Header="Bucket B Size" Binding="{Binding BucketBSizeDisplay}" Width="90" FontSize="11"/>
                        <DataGridTextColumn Header="Existing Partner Metadata" Binding="{Binding MetadataSummary}" Width="2*" FontSize="11" FontFamily="Consolas"/>
                        <DataGridTextColumn Header="Explanation &amp; Details" Binding="{Binding Details}" Width="2*" FontSize="11"/>
                        <DataGridTextColumn Header="Detected" Binding="{Binding DetectedAt, StringFormat={}{0:HH:mm:ss}}" Width="75" FontSize="11"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- STATUS BAR -->
        <Border Grid.Row="3" Background="#0F172A" Padding="8,3" CornerRadius="4" BorderBrush="#334155" BorderThickness="1">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="Wasabi S3 Compare Tool | Zero-Disk-Persistence" 
                           Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#38BDF8" FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
